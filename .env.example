# --- Supabase ---------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Gemini -----------------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Set to "true" ONLY once the Google Cloud project behind the key above has a
# billing account linked. This changes what students are told, so it must match
# reality.
#
# Why it matters: on Google's UNPAID tier, Google uses submitted content to
# improve its products and human reviewers may read it — their terms state
# "Do not submit sensitive, confidential, or personal information to the Unpaid
# Services." Application essays are personal information. On the PAID tier
# prompts and responses are not used for product improvement.
#
# Left unset (the safe default) the app warns students in the workspace and on
# the privacy page that their essays may be read and used for training.
# GEMINI_PAID_TIER=true

# Model chains, comma-separated, tried left to right. The app falls over to the
# next model when one is out of quota or your key can't see it, so list more
# than one. Leave unset to use the built-in defaults.
#
# DIAGNOSTIC = the once-per-draft whole-essay scan. Worth a full Flash model;
# the free tier allows only ~5/min and ~20/day of these.
# GEMINI_MODEL_DIAGNOSTIC=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash
#
# CONVERSATION = every Socratic chat turn. Short context, runs often — the Flash
# Lite tier's ~15/min and ~500/day is what makes the loop usable.
# GEMINI_MODEL_CONVERSATION=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite

# --- App --------------------------------------------------------------------
# Used to build the OAuth redirect URL. Leave unset locally (falls back to the
# request origin); set it on Vercel to your production URL.
# NEXT_PUBLIC_SITE_URL=https://essence.vercel.app
